<!-- G12a / G12b UI styles (D058, D060): top menu choice, Glass, clock and profile access. -->
<resources>
    <string name="settings_navigation_style_title">Navigation style</string>
    <string name="settings_navigation_style_description">Where the main menu sits: the sidebar, a bar across the top, a floating pill, or Glass (frosted, over the Modern home; Pill with other layouts). The sidebar is the default.</string>
    <string name="navigation_style_sidebar">Sidebar</string>
    <string name="navigation_style_top_bar">Top bar</string>
    <string name="navigation_style_pill">Pill</string>
    <string name="navigation_style_glass">Glass</string>
    <string name="settings_lightweight_effects_title">Lightweight effects</string>
    <string name="settings_lightweight_effects_description">Draws the Glass menu without live blur. Devices with little memory or older than Android 12 always do.</string>
    <string name="settings_top_menu_clock_title">Clock in the top menu</string>
    <string name="settings_top_menu_clock_description">Shows the time beside the top menu, in this device\'s 12- or 24-hour format.</string>
    <string name="top_menu_switch_profile">%1$s · switch profile</string>
</resources>
