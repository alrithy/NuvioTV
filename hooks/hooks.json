{
  "description": "Read-only Nuvio repository snapshot; recovery belongs to the agent workflow.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 20,
            "statusMessage": "Reading Nuvio repository state",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
